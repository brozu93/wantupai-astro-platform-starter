---
import '../styles/globals.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/800.css';
import interFont400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import interFont800 from '@fontsource/inter/files/inter-latin-800-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
    description?: string;
    /** Studio pages want the full window; content pages stay readable. */
    wide?: boolean;
}

const { title, description = 'KAKAS membina perkakas digital untuk kerja tangan. Penjana STL nametag kerajaan, sekolah dan korporat untuk pencetak 3D.', wide = false } =
    Astro.props;

const fullTitle = title === 'KAKAS' ? 'KAKAS — Perkakas digital untuk pencetak 3D' : `${title} — KAKAS`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="ms" data-theme="kakas">
    <head>
        <meta charset="UTF-8" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonical} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" as="font" type="font/woff2" href={interFont400} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={interFont800} crossorigin />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="KAKAS" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:locale" content="ms_MY" />
        <meta name="twitter:card" content="summary" />
        <meta name="theme-color" content="#0F1318" />
    </head>
    <body class="min-h-screen bg-graphite-900 text-base-content antialiased">
        <div class="flex min-h-screen flex-col bg-workshop-grain">
            <Header />
            <main class="grow">
                <div class:list={['mx-auto w-full px-5 sm:px-8', wide ? 'max-w-[1500px]' : 'max-w-6xl']}>
                    <slot />
                </div>
            </main>
            <Footer />
        </div>
    </body>
</html>
