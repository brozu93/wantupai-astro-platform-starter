---
import Layout from '../layouts/Layout.astro';
import PlanPicker from '../components/billing/PlanPicker';
import { FREE_TIER, PLANS, formatPrice } from '../lib/billing/plans';
import { paymentsConfigured } from '../lib/billing/stripe';

export const prerender = false;

// Whether real payments are wired up is a runtime fact, so the page is rendered on request.
const live = paymentsConfigured();

const faqs = [
    {
        q: 'Apa beza kredit dan langganan?',
        a: 'Satu kredit membuka satu reka bentuk. Selepas dijana, reka bentuk yang sama boleh dimuat turun berulang kali tanpa kos tambahan — ubah satu huruf pun ia dikira reka bentuk baharu. Langganan bulanan pula membenarkan reka bentuk tanpa had sepanjang langganan aktif.'
    },
    {
        q: 'Boleh saya jual tag yang saya cetak?',
        a: 'Boleh, dengan langganan bulanan yang termasuk lesen guna komersial. Pelan Bayar Sekali adalah untuk kegunaan sendiri.'
    },
    {
        q: 'Saya tersalah taip nama selepas membeli. Kena bayar lagi?',
        a: 'Ya, sebab teks yang berbeza menghasilkan geometri yang berbeza. Sebab itulah pratonton adalah percuma dan penuh — semak ejaan pada skrin sebelum membayar.'
    },
    {
        q: 'Bagaimana untuk membatalkan langganan?',
        a: 'Hubungi kami dengan kunci lesen anda dan langganan akan dibatalkan. Anda kekal boleh menjana STL sehingga tamat tempoh yang sudah dibayar.'
    }
];
---

<Layout title="Harga" description="Bayar sekali RM 15 untuk satu reka bentuk STL, atau langgan RM 29 sebulan untuk STL nametag tanpa had.">
    <section class="py-14">
        <p class="text-xs font-semibold uppercase tracking-widest text-brass-400">Harga</p>
        <h1 class="mt-2">Bayar untuk fail, bukan untuk langganan yang tidak dipakai.</h1>
        <p class="mt-4 max-w-2xl text-graphite-300">
            Mereka bentuk dan melihat pratonton adalah percuma sepenuhnya. Anda hanya membayar apabila mahu memuat turun fail STL untuk nama sebenar.
        </p>

        {
            !live && (
                <p class="mt-6 rounded-lg border border-warning/40 bg-warning/10 px-4 py-3 text-sm text-warning">
                    <strong class="font-semibold">Mod demo.</strong> Gerbang pembayaran belum dikonfigurasikan pada tapak ini, jadi “pembayaran” akan diluluskan
                    serta-merta tanpa wang bertukar tangan dan lesen yang dikeluarkan ditanda sebagai lesen demo.
                </p>
            )
        }

        <div class="mt-10 grid gap-5 lg:grid-cols-3">
            <div class="panel p-6">
                <h2 class="text-xl">{FREE_TIER.label}</h2>
                <p class="tabular mt-2 text-3xl font-extrabold">RM 0</p>
                <ul class="mt-5 space-y-2 text-sm text-graphite-300">
                    {
                        FREE_TIER.features.map((feature) => (
                            <li class="flex gap-2">
                                <span aria-hidden="true" class="text-graphite-500">
                                    ✓
                                </span>
                                {feature}
                            </li>
                        ))
                    }
                </ul>
                <a href="/apps/nametag" class="btn btn-outline btn-sm mt-6 border-white/20">Mula reka</a>
            </div>

            {
                PLANS.map((plan) => (
                    <div class:list={['panel p-6', plan.mode === 'subscription' && 'border-brass-400/50']}>
                        <div class="flex items-start justify-between gap-3">
                            <h2 class="text-xl">{plan.label}</h2>
                            {plan.mode === 'subscription' && (
                                <span class="rounded-full bg-brass-400/20 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-brass-300">
                                    Untuk sekolah
                                </span>
                            )}
                        </div>
                        <p class="tabular mt-2 text-3xl font-extrabold text-brass-300">
                            {formatPrice(plan.amount)}
                            {plan.mode === 'subscription' && <span class="text-base font-normal text-graphite-400">/bulan</span>}
                        </p>
                        <p class="mt-1 text-sm text-graphite-300">{plan.bestFor}</p>
                        <ul class="mt-5 space-y-2 text-sm text-graphite-300">
                            {plan.features.map((feature) => (
                                <li class="flex gap-2">
                                    <span aria-hidden="true" class="text-brass-400">
                                        ✓
                                    </span>
                                    {feature}
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </section>

    <section class="border-t border-white/10 py-12">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,520px)_minmax(0,1fr)]">
            <div>
                <h2>Beli sekarang</h2>
                <p class="mb-5 mt-2 text-sm text-graphite-300">Semua harga dalam Ringgit Malaysia.</p>
                <PlanPicker client:load />
            </div>

            <div>
                <h2>Soalan lazim</h2>
                <dl class="mt-5 space-y-5">
                    {
                        faqs.map((faq) => (
                            <div class="panel p-5">
                                <dt class="font-semibold">{faq.q}</dt>
                                <dd class="mt-2 text-sm text-graphite-300">{faq.a}</dd>
                            </div>
                        ))
                    }
                </dl>
                <p class="mt-5 text-sm text-graphite-400">
                    Baca juga <a href="/terma" class="underline underline-offset-4">terma dan dasar bayaran balik</a>.
                </p>
            </div>
        </div>
    </section>
</Layout>
