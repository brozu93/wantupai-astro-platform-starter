---
import PlanPicker from '../billing/PlanPicker';
import { langFromUrl, path } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { FREE_TIER, PLANS, formatPrice } from '../../lib/billing/plans';
import { paymentsConfigured } from '../../lib/billing/stripe';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);

// Whether real payments are wired up is a runtime fact, so the page is rendered on request.
const live = paymentsConfigured();

const faqs = [1, 2, 3, 4] as const;
---

<Layout title={t('pricing.title')} description={t('pricing.description')}>
    <section class="py-14">
        <p class="text-xs font-semibold uppercase tracking-widest text-brass-400">{t('pricing.title')}</p>
        <h1 class="mt-2">{t('pricing.heading')}</h1>
        <p class="mt-4 max-w-2xl text-graphite-300">{t('pricing.lede')}</p>

        {
            !live && (
                <p class="mt-6 rounded-lg border border-warning/40 bg-warning/10 px-4 py-3 text-sm text-warning">
                    <strong class="font-semibold">{t('pricing.demoStrong')}</strong> {t('pricing.demoBody')}
                </p>
            )
        }

        <div class="mt-10 grid gap-5 lg:grid-cols-3">
            <div class="panel p-6">
                <h2 class="text-xl">{t(FREE_TIER.labelKey)}</h2>
                <p class="tabular mt-2 text-3xl font-extrabold">RM 0</p>
                <ul class="mt-5 space-y-2 text-sm text-graphite-300">
                    {
                        FREE_TIER.featureKeys.map((key) => (
                            <li class="flex gap-2">
                                <span aria-hidden="true" class="text-graphite-500">
                                    ✓
                                </span>
                                {t(key)}
                            </li>
                        ))
                    }
                </ul>
                <a href={path('nametag', lang)} class="btn btn-outline btn-sm mt-6 border-white/20">{t('pricing.startDesigning')}</a>
            </div>

            {
                PLANS.map((plan) => (
                    <div class:list={['panel p-6', plan.mode === 'subscription' && 'border-brass-400/50']}>
                        <div class="flex items-start justify-between gap-3">
                            <h2 class="text-xl">{t(plan.labelKey)}</h2>
                            {plan.mode === 'subscription' && (
                                <span class="rounded-full bg-brass-400/20 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-brass-300">
                                    {t('pricing.forSchools')}
                                </span>
                            )}
                        </div>
                        <p class="tabular mt-2 text-3xl font-extrabold text-brass-300">
                            {formatPrice(plan.amount)}
                            {plan.mode === 'subscription' && <span class="text-base font-normal text-graphite-400">{t('pricing.perMonth')}</span>}
                        </p>
                        <p class="mt-1 text-sm text-graphite-300">{t(plan.bestForKey)}</p>
                        <ul class="mt-5 space-y-2 text-sm text-graphite-300">
                            {plan.featureKeys.map((key) => (
                                <li class="flex gap-2">
                                    <span aria-hidden="true" class="text-brass-400">
                                        ✓
                                    </span>
                                    {t(key)}
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </section>

    <section class="border-t border-white/10 py-12">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,520px)_minmax(0,1fr)]">
            <div>
                <h2>{t('pricing.buyNow')}</h2>
                <p class="mb-5 mt-2 text-sm text-graphite-300">{t('pricing.currencyNote')}</p>
                <PlanPicker lang={lang} client:load />
            </div>

            <div>
                <h2>{t('pricing.faqTitle')}</h2>
                <dl class="mt-5 space-y-5">
                    {
                        faqs.map((n) => (
                            <div class="panel p-5">
                                <dt class="font-semibold">{t(`pricing.faq${n}.q` as 'pricing.faq1.q')}</dt>
                                <dd class="mt-2 text-sm text-graphite-300">{t(`pricing.faq${n}.a` as 'pricing.faq1.a')}</dd>
                            </div>
                        ))
                    }
                </dl>
                <p class="mt-5 text-sm text-graphite-400">
                    {t('pricing.readTermsBefore')}<a href={path('terms', lang)} class="underline underline-offset-4">{t('pricing.readTermsLink')}</a>{
                        t('pricing.readTermsAfter')
                    }
                </p>
            </div>
        </div>
    </section>
</Layout>
