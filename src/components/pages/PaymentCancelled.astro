---
import { langFromUrl, path } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('cancelled.title')} description={t('cancelled.description')}>
    <section class="py-14">
        <p class="text-xs font-semibold uppercase tracking-widest text-graphite-400">{t('cancelled.eyebrow')}</p>
        <h1 class="mt-2">{t('cancelled.heading')}</h1>
        <p class="mt-4 max-w-2xl text-graphite-300">{t('cancelled.lede')}</p>
        <div class="mt-8 flex flex-wrap gap-3">
            <a href={path('nametag', lang)} class="btn btn-primary">{t('cancelled.backToStudio')}</a>
            <a href={path('pricing', lang)} class="btn btn-outline border-white/20">{t('cancelled.pricingAgain')}</a>
        </div>
    </section>
</Layout>
