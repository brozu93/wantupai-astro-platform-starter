---
interface Props {
    class?: string;
    /** Height in pixels; the width follows the aspect ratio. */
    height?: number;
}

const { class: className, height = 34 } = Astro.props;
---

<!-- The mark is a nametag plate seen face on: rounded plate, engraved bar, two magnet points. -->
<svg
    class:list={['block', className]}
    height={height}
    viewBox="0 0 210 44"
    fill="none"
    role="img"
    aria-label="KAKAS"
    xmlns="http://www.w3.org/2000/svg"
>
    <rect x="1.5" y="6.5" width="52" height="31" rx="7" stroke="currentColor" stroke-opacity="0.55" stroke-width="3"></rect>
    <rect x="11" y="17" width="33" height="4.5" rx="2.25" fill="#F5A524"></rect>
    <rect x="11" y="25" width="21" height="3.5" rx="1.75" fill="currentColor" fill-opacity="0.5"></rect>
    <circle cx="16" cy="12" r="2" fill="currentColor" fill-opacity="0.35"></circle>
    <circle cx="39" cy="12" r="2" fill="currentColor" fill-opacity="0.35"></circle>
    <text
        x="68"
        y="32"
        font-family="Inter, system-ui, sans-serif"
        font-size="27"
        font-weight="800"
        letter-spacing="2.5"
        fill="currentColor">KAKAS</text
    >
</svg>
