---
import Logo from '../ui/Logo.astro';

const navItems = [
    { label: 'Apps', href: '/apps' },
    { label: 'Penjana Nametag', href: '/apps/nametag' },
    { label: 'Harga', href: '/harga' },
    { label: 'Panduan', href: '/panduan' },
    { label: 'Akaun', href: '/akaun' }
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(`${href}/`));
---

<header class="sticky top-0 z-30 border-b border-white/10 bg-graphite-900/85 backdrop-blur">
    <nav class="mx-auto flex max-w-[1500px] flex-wrap items-center gap-x-6 gap-y-3 px-5 py-3 sm:px-8" aria-label="Utama">
        <a href="/" class="shrink-0 text-base-content hover:opacity-80" aria-label="KAKAS, ke laman utama">
            <Logo height={30} />
        </a>

        <ul class="flex flex-wrap items-center gap-x-1 gap-y-1 text-sm">
            {
                navItems.map((item) => (
                    <li>
                        <a
                            href={item.href}
                            aria-current={isCurrent(item.href) ? 'page' : undefined}
                            class:list={[
                                'inline-block rounded-md px-2.5 py-1.5 transition',
                                isCurrent(item.href) ? 'bg-white/10 font-semibold text-base-content' : 'text-graphite-200 hover:bg-white/5'
                            ]}
                        >
                            {item.label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <a href="/apps/nametag" class="btn btn-primary btn-sm ml-auto">Buka Studio</a>
    </nav>
</header>
