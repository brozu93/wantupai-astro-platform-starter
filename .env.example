# Payments. Without STRIPE_SECRET_KEY the site runs in demo mode: purchases are
# simulated, no money moves, and every licence issued is flagged as a demo licence.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Site origin, used to build the return URLs handed to the payment gateway.
# Netlify sets this automatically in production; set it manually elsewhere.
# URL=http://localhost:4321
